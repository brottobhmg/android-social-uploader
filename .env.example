# API Keys for LLM Providers
# Copy this file to .env and fill in your actual API keys

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# NVIDIA NIM API Key
# Get from: https://build.nvidia.com/explore/discover
# NOTE: NVIDIA NIM is the default provider and enables a ZERO-COST pipeline
# (free tier). Review the NVIDIA NIM terms of service for rate limits, model
# availability and intended (evaluation) use before relying on it in production.
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# Cerebras API Key
# Get from: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Optional: NVIDIA NIM Base URL (if using a different endpoint)
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: Device ID (leave empty if only one device connected)
# DEVICE_ID=your_device_serial_here

# Optional: API URL for media uploads (job polling backend)
# Required only for the job-processing mode (job_runner.py). Leave empty otherwise.
# API_URL=http://your-vps-address:port

# Optional: API token for the job polling backend
# Every job route requires "Authorization: Bearer <API_TOKEN>". The server
# answers 401 when the token is missing or wrong, 503 when it has none
# configured. Both are configuration errors: the client does not retry them.
# API_TOKEN=your_api_token_here

# Optional: seconds to wait before polling again after the token was refused
# (default 300). A wrong token is a configuration error, not a transient one.
# AUTH_ERROR_BACKOFF=300

# Optional: seconds to wait when the server answers 429 (rate limit)
# (default 60). The limit is shared with the dashboard.
# RATE_LIMIT_BACKOFF=60

# Optional: enable debug mode (verbose logging, annotated screenshots, guides)
# Can also be enabled at runtime with the --debug flag.
# DEBUG=false

# Optional: polling interval in seconds (job_runner.py)
# POLL_INTERVAL=15

# Optional: local directory where downloaded media is stored temporarily
# LOCAL_DOWNLOAD_DIR=./downloads

# Optional: max corrective attempts per agent click
# MAX_AGENT_ATTEMPTS=10

# Optional: answer to the YouTube Studio "AI usage" disclosure
# YouTube keeps the publish button disabled until it is answered.
# "No" means the content was not generated or modified by AI.
# AI_DISCLOSURE=No

# Optional: category assigned to every YouTube upload (one is required)
# YOUTUBE_CATEGORY=Scienza e tecnologia